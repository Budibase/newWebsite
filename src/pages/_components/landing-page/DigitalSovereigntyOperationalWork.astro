---
import CheckCircleFill from "phosphor-astro/CheckCircleFill.astro";
import SecurityDemoOne from "@components/SecurityDemoOne.astro";
import SectionBlock from "@components/SectionBlock.astro";
import Button from "@components/Button.astro";
---

<section>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)] lg:items-center lg:gap-20">
    <SectionBlock
      titleColorMode="split-secondary-primary"
      titleLines={[
        { text: "Critical work" },
        { text: "Under your control" },
      ]}
      description="IT teams choose Budibase to manage requests, approvals, and other operational processes where control and oversight matter."
      maxWidth="xl"
      spacing="default"
      contentClass="pt-1"
    >
      <ul class="m-0 flex flex-col gap-4">
        <li class="flex items-start gap-3">
          <CheckCircleFill
            class="mt-0.5 h-5 w-5 flex-shrink-0 text-[var(--accent-blue)]"
            aria-hidden="true"
          />
          <div class="m-0 text-[15px] font-medium leading-6 text-[var(--text-primary)]">
            Deploy request management Agents to internal messaging apps.
          </div>
        </li>

        <li class="flex items-start gap-3">
          <CheckCircleFill
            class="mt-0.5 h-5 w-5 flex-shrink-0 text-[var(--accent-blue)]"
            aria-hidden="true"
          />
          <div class="m-0 text-[15px] font-medium leading-6 text-[var(--text-primary)]">
            Build rules-based automations and data management UIs.
          </div>
        </li>

        <li class="flex items-start gap-3">
          <CheckCircleFill
            class="mt-0.5 h-5 w-5 flex-shrink-0 text-[var(--accent-blue)]"
            aria-hidden="true"
          />
          <div class="m-0 text-[15px] font-medium leading-6 text-[var(--text-primary)]">
            Out-of-the-box audit logging, authentication, user management & more.
          </div>
        </li>
      </ul>

      <div class="mt-16">
        <Button
          label="Book a demo"
          url="/contact/"
          variant="primary"
          size="large"
          class="px-6 py-3 text-xl md:px-7 md:py-3.5 md:text-xl"
        />
      </div>
    </SectionBlock>

    <div>
      <SecurityDemoOne />
    </div>
  </div>
</section>